generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // Optional: connection settings
  relationMode = "prisma" // or "foreignKeys"
}



model Project {
  id        String   @id @default(uuid())
  name      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}